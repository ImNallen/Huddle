{
  "name": "@huddle/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx runtime/dev.ts",
    "build": "vite build",
    "start": "node --env-file=../../.env --import tsx runtime/production.ts",
    "typecheck": "tsc && node --import tsx scripts/check-admission.ts",
    "db:migrate": "node --env-file=../../.env --import tsx scripts/migrate.ts",
    "test:integration": "node --env-file=../../.env --import tsx scripts/integration.ts",
    "email:test": "node --env-file=../../.env --import tsx scripts/email-test.ts",
    "test:email": "node --env-file=../../.env --import tsx scripts/email-integration.ts",
    "test:access": "node --env-file=../../.env --import tsx scripts/access-integration.ts",
    "account:reset": "node --env-file=../../.env --import tsx scripts/account-reset.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@huddle/contracts": "workspace:*",
    "@simplewebauthn/server": "13.2.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.7",
    "jose": "6.1.3",
    "nodemailer": "10.0.16",
    "otpauth": "9.4.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.5",
    "tsx": "4.20.6",
    "ws": "8.18.3",
    "zod": "4.6.5",
    "@huddle/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
