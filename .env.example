# pnpm setup:local creates .env with independent random secrets.
DATABASE_URL=postgresql://huddle:GENERATE_WITH_SETUP@localhost:5434/huddle
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
BETTER_AUTH_SECRET=GENERATE_WITH_SETUP
SERVER_URL=http://localhost:3000
PORT=3000
WS_PORT=3001
WS_PUBLIC_URL=ws://localhost:3001
TRUSTED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# The server prints a one-time setup code until it is set up.
# Set SETUP_CODE (8-64 characters) to supply the code instead, for example in automation.
# SETUP_CODE=
