DATABASE_URL=postgresql://huddle:GENERATE_WITH_SETUP@localhost:5434/huddle
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
SERVER_URL=http://localhost:3000
PORT=3002
WS_PORT=3003
WS_PUBLIC_URL=ws://localhost:3000/events
HUDDLE_DEV_LOGIN=you@huddle.local
TRUSTED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# The server prints a one-time setup code until it is set up.
# Set SETUP_CODE (8-64 characters) to supply the code instead, for example in automation.
# SETUP_CODE=

# A socket closes after this long and reconnects, so Tailscale attests it again.
# SOCKET_MAX_AGE_SECONDS=300

# Compose only: a Tailscale auth key for the sidecar. Without one, the sidecar's log prints a login link.
# TS_AUTHKEY=
